# Application
APP_NAME=AdMention AI
APP_ENV=development
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://adverify.codewithbharat.dev

# PostgreSQL (Docker Compose default)
POSTGRES_USER=admention
POSTGRES_PASSWORD=admention
POSTGRES_DB=admention
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://admention:admention@postgres:5432/admention

# Local development without Docker:
# DATABASE_URL=sqlite:///./admention.db

# YouTube Data API (optional — metadata falls back to oEmbed)
YOUTUBE_API_KEY=

# OpenAI (used later for mention verification/classification)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Whisper fallback (local development can use mock)
WHISPER_ENABLED=false
WHISPER_PROVIDER=mock
WHISPER_MODEL=base
# Optional path to a local audio file when WHISPER_PROVIDER=local
WHISPER_SAMPLE_PATH=

# Mention context window
MENTION_CONTEXT_BEFORE=2
MENTION_CONTEXT_AFTER=2

# Caption mirrors used when YouTube blocks cloud IPs (Render)
INVIDIOUS_INSTANCES=https://inv.nadeko.net
PIPED_INSTANCES=https://api.piped.private.coffee,https://pipedapi.r4fo.com,https://pipedapi.leptons.xyz,https://pipedapi.smnz.de

# Hostinger PHP relay. Render calls this so YouTube sees Hostinger's IP.
CAPTION_PROXY_URL=https://adverify.codewithbharat.dev/caption-proxy.php

# Residential proxy (Render). Do not commit real credentials.
# HTTP_PROXY=http://USERNAME:PASSWORD@p.webshare.io:80
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
